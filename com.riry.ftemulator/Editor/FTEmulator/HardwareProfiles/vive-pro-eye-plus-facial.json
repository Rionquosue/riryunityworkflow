    },
    {
      "name": "RightEyeSqueeze",
      "group": "Eyelid",
      "from": "EyeSquintRight"
    },
    {
      "name": "RightEyeWide",
      "group": "Eyelid",
      "from": "EyeWideRight"
    },
    {
      "name": "JawOpen",
      "group": "Jaw",
      "from": "clamp(JawOpen - MouthClosed, 0, 1)"
    },
    {
      "name": "JawLeft",
      "group": "Jaw",
      "from": "JawLeft"
    },
    {
