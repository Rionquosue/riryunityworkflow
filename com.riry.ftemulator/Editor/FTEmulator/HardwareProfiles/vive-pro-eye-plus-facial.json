{
  "schema": 1,
  "id": "vive-pro-eye-plus-facial",
  "name": "Vive Pro Eye + Facial Tracker",
  "detail": "Combined setup",
  "version": "1",
  "order": 70,
  "eyeTracking": true,
  "faceTracking": true,
  "evidence": [
    "H4 VRCFT Vive Pro Eye guide and SRanipal hardware matrix",
    "H5 VRCFaceTracking/SRanipalTrackingModule SRanipalTrackingInterface.cs at deecdfa3932c32899920415b837f10211c13b2ec"
  ],
  "notes": [
    "Sensor controls: per-eye gaze, openness, pupil diameter, squeeze and wide.",
    "Pupil diameter is normalised (0.5 neutral); dilation and constriction are derived from it by a fixed rule, not measured separately.",
    "Brows follow squeeze and wide only with Documented module behavior.",
    "SRanipal lip controls. CheekSuck drives both sides, MouthPout all four pucker quadrants, the two tongue steps one TongueOut.",
    "No tongue twist, flat, squish or curl; no nose wrinkle or lip press.",
    "Cheek squint, dimple and stretch follow the smile and sad controls only with Documented module behavior.",
    "The lower funnel and left stretch assignments are kept as the inspected module has them."
  ],
  "parameters": [
    {
      "name": "Viseme",
      "type": "Int",
      "min": 0,
      "max": 100
    },
    {
      "name": "Voice",
      "type": "Float",
      "min": 0,
      "max": 1
    }
  ],
  "controls": [
    {
      "name": "LeftGazeX",
      "group": "Gaze",
      "from": "EyeLookInLeft - EyeLookOutLeft",
      "min": -1
    },
    {
      "name": "LeftGazeY",
      "group": "Gaze",
      "from": "EyeLookUpLeft - EyeLookDownLeft",
      "min": -1
    },
    {
      "name": "LeftEyeOpenness",
      "group": "Eyelid",
      "from": "1 - EyeClosedLeft",
      "neutral": 1
    },
    {
      "name": "LeftPupilDiameter",
      "group": "Pupil",
      "from": "clamp(0.5 + (EyeDilationLeft - EyeConstrictLeft) / 2, 0, 1)",
      "neutral": 0.5
    },
    {
      "name": "LeftEyeSqueeze",
      "group": "Eyelid",
      "from": "EyeSquintLeft"
    },
    {
      "name": "LeftEyeWide",
      "group": "Eyelid",
      "from": "EyeWideLeft"
    },
    {
      "name": "RightGazeX",
      "group": "Gaze",
      "from": "EyeLookOutRight - EyeLookInRight",
      "min": -1
    },
    {
      "name": "RightGazeY",
      "group": "Gaze",
      "from": "EyeLookUpRight - EyeLookDownRight",
      "min": -1
    },
    {
      "name": "RightEyeOpenness",
