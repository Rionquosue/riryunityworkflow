# Unity creates these when the test project is opened.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
*.csproj
*.sln
.vs/
.idea/
# Everything Unity and the tools create under Assets; .gitkeep keeps the folder.
/Assets/*
!/Assets/.gitkeep
# Unity fills in the rest of ProjectSettings and Packages on first open.
/ProjectSettings/*
!/ProjectSettings/ProjectVersion.txt
!/ProjectSettings/EditorSettings.asset
/Packages/packages-lock.json
